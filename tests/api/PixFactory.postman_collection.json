{
  "info": {
    "name": "PixFactory API",
    "description": "Contratos REST do PixFactory: auth JWT, clientes, contratos, dashboard, agenda e pagamentos DEMO.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login DEMO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('token e usuario', () => {",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user.email).to.eql('demo@pixfactory.app');",
                  "  pm.expect(json.user.role).to.eql('USER');",
                  "});",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login senha invalida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "const json = pm.response.json();",
                  "pm.test('contrato de erro', () => {",
                  "  pm.expect(json.status).to.eql(401);",
                  "  pm.expect(json.message).to.be.a('string');",
                  "  pm.expect(json.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@pixfactory.app\",\n  \"password\": \"errada\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('email DEMO', () => pm.expect(pm.response.json().email).to.eql('demo@pixfactory.app'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Me sem token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('array com nome e cpf', () => {",
                  "  pm.expect(list).to.be.an('array').and.not.empty;",
                  "  pm.expect(list[0]).to.have.property('nome');",
                  "  pm.expect(list[0]).to.have.property('cpf');",
                  "});",
                  "pm.environment.set('clientId', String(list[0].id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/clients"
          }
        },
        {
          "name": "Buscar por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('id bate', () => pm.expect(String(pm.response.json().id)).to.eql(pm.environment.get('clientId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/clients/{{clientId}}"
          }
        },
        {
          "name": "Cliente inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('mensagem', () => pm.expect(pm.response.json().message).to.match(/n[aã]o encontrado/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/clients/999999"
          }
        },
        {
          "name": "CPF duplicado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const list = pm.variables.get('_skip');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('mensagem de cpf', () => pm.expect(pm.response.json().message).to.match(/CPF/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Duplicado QA\",\n  \"cpf\": \"529.982.247-25\",\n  \"telefone\": \"11911112222\",\n  \"email\": \"dup.qa@example.com\",\n  \"endereco\": \"Rua QA\",\n  \"classificacao\": \"Médio\"\n}"
            },
            "url": "{{baseUrl}}/api/clients"
          }
        }
      ]
    },
    {
      "name": "Contratos e dashboard",
      "item": [
        {
          "name": "Listar contratos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('contrato tem saldo', () => {",
                  "  pm.expect(list).to.be.an('array');",
                  "  if (list.length) pm.expect(list[0]).to.have.property('saldoDevedor');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/contracts"
          }
        },
        {
          "name": "Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('metricas', () => {",
                  "  pm.expect(json).to.have.property('totalEmprestado');",
                  "  pm.expect(json).to.have.property('activity');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/dashboard"
          }
        },
        {
          "name": "Agenda",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/appointments"
          }
        },
        {
          "name": "Pagamentos DEMO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/payments"
          }
        }
      ]
    },
    {
      "name": "Autorizacao",
      "item": [
        {
          "name": "USER nao lista usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "ADMIN lista usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()[0]).to.have.property('email');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Clients sem autenticacao",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients"
          }
        }
      ]
    }
  ]
}
