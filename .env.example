# Copie este arquivo para .env e ajuste se necessário.
# Nunca commite o arquivo .env com segredos reais.

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pixfactory?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=pixfactory
SPRING_DATASOURCE_PASSWORD=pixfactory
JWT_SECRET=pixfactory-demo-secret-change-me-please-32chars!!
JWT_EXPIRATION_MS=86400000
PIXFACTORY_SEED=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SERVER_PORT=8080
